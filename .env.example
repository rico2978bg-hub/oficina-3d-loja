# Set actual values in the server environment. Never commit secrets.
# The company target enforces production. This file does not change Sites access.
APP_MODE=demo
CHECKOUT_ENABLED=false
SITE_URL=https://previa.example.net
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Comma-separated Firebase UIDs. These are verified on every server admin operation.
ADMIN_UIDS=
# test calls Mercado Pago with a TEST SELLER account; use separate Firebase/catalog.
PAYMENTS_MODE=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# HTTPS shipping adapter. Contract is documented in docs/CONFIGURACAO.md.
SHIPPING_QUOTE_URL=
SHIPPING_API_KEY=
# Exact official privacy text and official banner URL, supplied by the business.
PRIVACY_POLICY_TEXT=
OFFICIAL_BANNER_URL=

# Owner-approved legal identity, final texts and retention decisions. No placeholders in production.
LEGAL_APPROVED=false
TERMS_TEXT=
RETURNS_POLICY_TEXT=
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_DOCUMENT=
PRIVACY_CONTACT=
DATA_RETENTION_POLICY=
# Numeric seller ID confirmed by Mercado Pago /users/me. Never mix test/live accounts.
MERCADO_PAGO_SELLER_ID=
RESERVATION_MINUTES=30
# Optional server-side GA4 Measurement Protocol. Keep disabled until external validation.
GA_ANALYTICS_ENABLED=false
GA_MEASUREMENT_ID=
GA_API_SECRET=

# Keep false until owners approve and validate the stock-release policy.
RESERVATION_AUTO_RELEASE=false

# Storefront catalog cache per Worker instance, in seconds (default 60; 0 disables). Orders always re-read price/stock.
CATALOG_CACHE_SECONDS=60
